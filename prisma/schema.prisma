datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CAPTAIN") // "ADMIN" | "CAPTAIN"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips        TripRecord[]
  deletedTrips DeletedTripRecord[]
  auditLogs    AuditLog[]
}

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?
  isActive  Boolean  @default(true)
  availabilityVersion Int @default(0)
  createdAt DateTime @default(now())

  routesFrom Route[] @relation("FromArea")
  routesTo   Route[] @relation("ToArea")
}

model Route {
  id         String   @id @default(cuid())
  fromAreaId String
  toAreaId   String
  price      Float
  isActive   Boolean  @default(true)
  isOpen     Boolean  @default(false)
  availabilityVersion Int @default(0)
  availabilityChangedAt DateTime?
  availabilityChangedBy String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  fromArea Area         @relation("FromArea", fields: [fromAreaId], references: [id])
  toArea   Area         @relation("ToArea", fields: [toAreaId], references: [id])
  trips    TripRecord[]
  orders   Order[]

  @@unique([fromAreaId, toAreaId])
}

enum OrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Order {
  id               String @id @default(cuid())
  routeId          String
  route            Route @relation(fields: [routeId], references: [id], onDelete: Restrict)
  fromAreaName      String
  toAreaName        String
  pickupBuilding   String
  senderPhone      String
  deliveryBuilding String
  receiverPhone    String
  notes            String @default("")
  status           OrderStatus @default(ACTIVE)
  source           String
  requestKey       String @unique
  trackingNumber   String @unique @default(dbgenerated("upper(replace(gen_random_uuid()::text, '-', ''))"))
  cancellationNote String?
  version          Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?
  completedAt      DateTime?
  completedBy      String?
  cancelledAt      DateTime?
  cancelledBy      String?

  @@index([status, createdAt, id])
  @@index([routeId])
}

// Content-free invalidation only. Customer records are never published to Realtime.
model IntakeRevision {
  id      String @id
  version BigInt @default(0)
}

model IntakeSettings {
  id                          String @id @default("default")
  captainCanChangeAvailability Boolean @default(false)
  version                     Int @default(0)
  updatedAt                   DateTime @default(now()) @updatedAt
  updatedBy                   String?
}

model TripRecord {
  id          String   @id @default(cuid())
  captainId   String
  routeId     String
  unitPrice   Float
  ordersCount Int      @default(1)
  status      String   @default("ACTIVE") // "ACTIVE" | "DELETED"
  createdAt   DateTime @default(now())

  captain User  @relation(fields: [captainId], references: [id])
  route   Route @relation(fields: [routeId], references: [id])

  deletedRecord DeletedTripRecord?
}

model DeletedTripRecord {
  id              String   @id @default(cuid())
  originalTripId  String   @unique
  deletedByUserId String
  reason          String   @default("UNDO")
  deletedAt       DateTime @default(now())

  originalTrip TripRecord @relation(fields: [originalTripId], references: [id])
  deletedBy    User       @relation(fields: [deletedByUserId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actionType  String   // "ENTRY_CREATED" | "ENTRY_UPDATED" | "ENTRY_DELETED" | "ENTRY_RESTORED"
  userId      String
  captainName String
  routeInfo   String?  // e.g. "Yasmeen → Narges"
  ordersCount Int?
  amount      Float?
  oldValues   String?  // e.g. "Orders: 2"
  newValues   String?  // e.g. "Orders: 3"
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
